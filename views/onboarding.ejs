<%- include('header') %>

<h1 class="page-title">Onboarding</h1>
<p class="page-sub">Registration risk evaluation, email verification &amp; progressive role unlocking.</p>

<!-- Stats -->
<div class="stats-row" style="grid-template-columns:repeat(3,1fr);">
  <div class="stat-box">
    <div class="stat-label">Total Users</div>
    <div class="stat-value"><%= total_users %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Trusted</div>
    <div class="stat-value"><%= trusted_users %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Probationary</div>
    <div class="stat-value"><%= probationary %></div>
  </div>
</div>

<div class="two-col">

  <!-- Register Form -->
  <div class="card">
    <div class="card-row">
      <div class="card-title" style="margin-bottom:0">Evaluate Registration</div>
      <form method="post">
        <input type="hidden" name="action" value="run_onboarding_batch">
        <button type="submit" class="btn btn-secondary btn-sm">⚡ Run Batch</button>
      </form>
    </div>
    <br>
    <form method="post">
      <input type="hidden" name="action" value="register_user">
      <div class="form-group">
        <label class="form-label">WP User ID</label>
        <input type="number" name="wp_user_id" class="form-control" value="105">
      </div>
      <div class="form-group">
        <label class="form-label">Username</label>
        <input type="text" name="username" class="form-control" placeholder="e.g. alex_reviewer" required>
      </div>
      <div class="form-group">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" placeholder="user@gmail.com" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Evaluate &amp; Register</button>
    </form>
  </div>

  <!-- Users Table -->
  <div class="card">
    <div class="card-title">Registered Users</div>
    <% if (users && users.length > 0) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>User</th><th>Risk</th><th>Stage</th><th>Role</th><th>Post?</th><th>Update</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function(u) { %>
          <tr>
            <td><strong style="color:#fff"><%= u.username %></strong><br><small><%= u.email %></small></td>
            <td>
              <span class="badge badge-<%= u.risk_score > 0.5 ? 'red' : (u.risk_score > 0.2 ? 'amber' : 'green') %>">
                <%= Number(u.risk_score).toFixed(2) %>
              </span>
            </td>
            <td><span class="badge badge-blue"><%= u.onboarding_stage %></span></td>
            <td style="font-size:0.78rem"><%= u.assigned_role %></td>
            <td><% if (u.can_post) { %><span class="badge badge-green">Yes</span><% } else { %><span class="badge badge-red">No</span><% } %></td>
            <td>
              <form method="post">
                <input type="hidden" name="action" value="update_asks">
                <input type="hidden" name="user_id" value="<%= u.id %>">
                <label style="font-size:0.7rem"><input type="checkbox" name="email_verified" <%= u.email_verified ? 'checked' : '' %>> Email verified</label><br>
                <input type="number" name="age" value="<%= u.age != null ? u.age : '' %>" placeholder="Age" style="width:55px;background:var(--bg-input);border:1px solid var(--border);color:#fff;border-radius:4px;padding:2px 6px;font-size:0.75rem;margin-top:3px">
                <input type="text" name="location" value="<%= u.location || '' %>" placeholder="CC" style="width:38px;background:var(--bg-input);border:1px solid var(--border);color:#fff;border-radius:4px;padding:2px 6px;font-size:0.75rem;">
                <br>
                <input type="text" name="bio" value="<%= u.bio || '' %>" placeholder="Bio..." style="width:110px;background:var(--bg-input);border:1px solid var(--border);color:#fff;border-radius:4px;padding:2px 6px;font-size:0.75rem;margin-top:3px">
                <br>
                <button type="submit" class="btn btn-secondary btn-sm" style="margin-top:4px">Save</button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="empty">No users yet. Evaluate a registration above.</div>
    <% } %>
  </div>

</div>

<%- include('footer') %>
