<%- include('header') %>

<h1 class="page-title">Analytics</h1>
<p class="page-sub">Module performance snapshots across all automation layers.</p>

<div class="stats-row">
  <div class="stat-box">
    <div class="stat-label">Total Runs</div>
    <div class="stat-value"><%= total_runs %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Successful</div>
    <div class="stat-value"><%= successful_runs %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Failed</div>
    <div class="stat-value"><%= failed_runs %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Items Processed</div>
    <div class="stat-value"><%= total_items %></div>
  </div>
</div>

<!-- Automation Task Log -->
<div class="card">
  <div class="card-row">
    <div class="card-title" style="margin-bottom:0">Task Log</div>
    <a href="/run-automation/" class="btn btn-primary btn-sm">⚡ Run Now</a>
  </div>
  <br>
  <% if (logs && logs.length > 0) { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Time</th><th>Pipeline</th><th>Status</th><th>Items</th><th>Duration</th><th>Summary</th></tr>
      </thead>
      <tbody>
        <% logs.forEach(function(log) { %>
        <tr>
          <td style="font-family:monospace; font-size:0.72rem; white-space:nowrap"><%= log.created_at %></td>
          <td style="font-size:0.8rem; color:#fff"><%= log.pipeline_name %></td>
          <td>
            <span class="badge badge-<%= log.status === 'completed' ? 'green' : (log.status === 'failed' ? 'red' : 'amber') %>">
              <%= log.status %>
            </span>
          </td>
          <td><span class="badge badge-blue"><%= log.items_processed %></span></td>
          <td style="color:var(--muted); font-size:0.75rem">
            <%= log.duration_seconds != null ? Number(log.duration_seconds).toFixed(1) + 's' : '—' %>
          </td>
          <td style="color:var(--muted); font-size:0.78rem"><%= log.summary.length > 60 ? log.summary.substring(0, 60) + '...' : log.summary %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <div class="empty">No task logs yet.</div>
  <% } %>
</div>

<!-- Module Snapshots -->
<% if (snapshots && snapshots.length > 0) { %>
<div class="card" style="margin-top:1.5rem;">
  <div class="card-title">Module Snapshots</div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Module</th><th>Date</th><th>Active Users</th><th>New Content</th><th>Flagged</th><th>Avg Score</th></tr>
      </thead>
      <tbody>
        <% snapshots.forEach(function(snap) { %>
        <tr>
          <td style="color:#fff; font-size:0.82rem"><%= snap.module_name || snap.module_key %></td>
          <td style="font-size:0.78rem; color:var(--muted)"><%= snap.snapshot_date %></td>
          <td><%= snap.active_users %></td>
          <td><%= snap.new_content_count %></td>
          <td><span class="badge badge-<%= snap.flagged_count > 5 ? 'red' : (snap.flagged_count > 1 ? 'amber' : 'green') %>"><%= snap.flagged_count %></span></td>
          <td><%= Number(snap.avg_quality_score).toFixed(2) %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<%- include('footer') %>
