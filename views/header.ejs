<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Learnami AutoEngine' %></title>
  <meta name="description" content="Agentix AI / Learnami: Multi-layer agent governance, content moderation, onboarding, identity resolution, vector memory RAG, and automation engine.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
  <div class="app-layout">
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <h1>⚡ Learnami</h1>
        <small>Automation Engine</small>
      </div>

      <span class="nav-section">Main</span>
      <a href="/onboarding/" class="nav-item <%= activeNav === 'onboarding' ? 'active' : '' %>">
        <span class="icon">👥</span> Onboarding &amp; Users
      </a>
      <a href="/" class="nav-item <%= activeNav === 'dashboard' ? 'active' : '' %>">
        <span class="icon">◻</span> Dashboard
      </a>
      <a href="/db-settings/" class="nav-item <%= activeNav === 'db_settings' ? 'active' : '' %>">
        <span class="icon">⬡</span> Database Setup
      </a>
      <a href="/smtp-settings/" class="nav-item <%= activeNav === 'smtp_settings' ? 'active' : '' %>">
        <span class="icon">✉</span> SMTP &amp; Email
      </a>

      <div class="sidebar-footer">
        <a href="/db-settings/" class="db-badge">
          <span class="dot <%= !db_status.is_mysql ? 'sqlite' : '' %>"></span>
          <% if (db_status.is_mysql) { %>
            MySQL: <%= db_status.db_name.substring(0, 14) %>
          <% } else { %>
            SQLite / In-Memory (Active)
          <% } %>
        </a>
        <form method="post" action="/onboarding/" style="margin:0;">
          <input type="hidden" name="action" value="run_onboarding_batch">
          <button type="submit" class="run-btn" style="width:100%; border:none; cursor:pointer;">⚡ Run Onboarding Batch</button>
        </form>
      </div>
    </aside>

    <!-- Page Content -->
    <div class="main-content">
      <% if (typeof messages !== 'undefined' && messages && messages.length > 0) { %>
        <% messages.forEach(function(msg) { %>
          <div class="alert alert-<%= msg.tags || 'info' %>">
            <span><%= msg.text %></span>
            <button class="alert-close" onclick="this.parentElement.remove()">×</button>
          </div>
        <% }); %>
      <% } %>
