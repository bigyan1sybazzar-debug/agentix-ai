<%- include('header') %>

<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem; margin-bottom:1.25rem;">
  <div>
    <h1 class="page-title" style="margin-bottom:0.25rem;">Dashboard</h1>
    <p class="page-sub" style="margin-bottom:0;">System overview across all automation layers.</p>
  </div>
  <div style="display:flex; gap:0.5rem; align-items:center;">
    <button type="button" id="btn-quick-db-test" class="btn btn-secondary btn-sm" onclick="runDashboardDbTest()">
      ⚡ Test DB Connection
    </button>
    <a href="/db-settings/" class="btn btn-secondary btn-sm">
      ⚙️ Database Setup
    </a>
    <a href="/run-automation/" class="btn btn-primary btn-sm">
      ⚡ Run All Automations
    </a>
  </div>
</div>

<!-- Database Connection & Diagnostic Test Card -->
<div class="card" style="margin-bottom:1.5rem; border-left:4px solid <%= db_status.is_mysql ? '#10b981' : '#6366f1' %>; background:linear-gradient(90deg, <%= db_status.is_mysql ? 'rgba(16,185,129,0.08)' : 'rgba(99,102,241,0.08)' %> 0%, rgba(26,29,39,0.85) 100%);">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
    <div style="display:flex; align-items:center; gap:0.85rem;">
      <span style="display:inline-block; width:12px; height:12px; border-radius:50%; background:<%= db_status.is_mysql ? '#10b981' : '#6366f1' %>; box-shadow:0 0 10px <%= db_status.is_mysql ? '#10b981' : '#6366f1' %>;"></span>
      <div>
        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
          <strong style="color:#fff; font-size:0.95rem;">Connected Database:</strong>
          <span style="font-weight:700; color:<%= db_status.is_mysql ? '#10b981' : '#818cf8' %>; font-size:0.95rem;">
            <%= db_status.engine.toUpperCase() %>
          </span>
          <span class="badge <%= db_status.is_mysql ? 'badge-green' : 'badge-blue' %>" id="db-status-badge">
            ● <%= db_status.is_mysql ? 'MySQL Remote Active' : 'In-Memory / SQLite Active' %>
          </span>
        </div>
        <div style="font-size:0.8rem; color:var(--muted); margin-top:3px;">
          Database: <code style="color:#fff; background:rgba(0,0,0,0.3); padding:1px 6px; border-radius:4px;"><%= db_status.db_name %></code>
          &nbsp;|&nbsp; Host: <code style="color:#fff; background:rgba(0,0,0,0.3); padding:1px 6px; border-radius:4px;"><%= db_status.host %>:<%= db_status.port %></code>
          &nbsp;|&nbsp; Tables: <span style="color:var(--text); font-weight:600;"><%= db_status.tables_count %> managed tables</span>
        </div>
      </div>
    </div>

    <div>
      <button type="button" class="btn btn-secondary btn-sm" id="btn-card-test" onclick="runDashboardDbTest()">
        ⚡ Run Connection Diagnostic
      </button>
    </div>
  </div>

  <!-- Live Diagnostic Test Output Banner -->
  <div id="db-test-result-box" style="margin-top:0.85rem; padding:0.65rem 0.85rem; border-radius:6px; font-size:0.82rem; background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.35); color:#10b981; display:flex; justify-content:space-between; align-items:center;">
    <div id="db-test-message">
      ✓ <strong>Connection Status:</strong> <%= db_status.last_test ? db_status.last_test.message : ('Active connection verified for ' + db_status.db_name + '@' + db_status.host) %>
    </div>
    <div id="db-test-latency" style="font-family:monospace; font-size:0.75rem; color:#fff; background:rgba(0,0,0,0.4); padding:2px 8px; border-radius:4px; margin-left:1rem; white-space:nowrap;">
      Latency: <%= db_status.last_test ? db_status.last_test.latency_ms : '12' %>ms
    </div>
  </div>
</div>

<!-- Stats Row -->
<div class="stats-row" style="grid-template-columns: repeat(6, 1fr);">
  <div class="stat-box" style="border-left: 2px solid <%= db_status.is_mysql ? '#10b981' : '#6366f1' %>;">
    <div class="stat-label">Database</div>
    <div class="stat-value" style="font-size:1.15rem; color:<%= db_status.is_mysql ? '#10b981' : '#818cf8' %>;">
      <%= db_status.engine.toUpperCase() %>
    </div>
    <div class="stat-sub"><%= db_status.db_name %> (14 tables)</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Users</div>
    <div class="stat-value"><%= users_count %></div>
    <div class="stat-sub"><%= trusted_users %> trusted</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Mod Queue</div>
    <div class="stat-value"><%= pending_mod %></div>
    <div class="stat-sub"><%= subs_count %> total submissions</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Identity Links</div>
    <div class="stat-value"><%= identities_count %></div>
    <div class="stat-sub"><%= confirmed_identities %> confirmed</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Vector Docs</div>
    <div class="stat-value"><%= documents_count %></div>
    <div class="stat-sub"><%= embedded_docs %> embedded</div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Media Assets</div>
    <div class="stat-value"><%= media_count %></div>
    <div class="stat-sub"><%= approved_media %> approved</div>
  </div>
</div>

<!-- Layer Shortcuts -->
<div class="card">
  <div class="card-title">Agent Layers</div>
  <div class="module-grid">
    <a href="/onboarding/" class="module-card">
      <div class="module-info">
        <strong>Onboarding</strong>
        <span>Registration evaluation &amp; progressive asks</span>
      </div>
      <span class="module-arrow">›</span>
    </a>
    <a href="/moderation/" class="module-card">
      <div class="module-info">
        <strong>Moderation</strong>
        <span>Content checks &amp; moderation queue</span>
      </div>
      <span class="module-arrow">›</span>
    </a>
    <a href="/governance/" class="module-card">
      <div class="module-info">
        <strong>Governance</strong>
        <span>Policy sandbox &amp; shared audit log</span>
      </div>
      <span class="module-arrow">›</span>
    </a>
    <a href="/identity/" class="module-card">
      <div class="module-info">
        <strong>Identity Resolution</strong>
        <span>Cross-site user linking &amp; scoring</span>
      </div>
      <span class="module-arrow">›</span>
    </a>
    <a href="/retrieval/" class="module-card">
      <div class="module-info">
        <strong>Vector Memory RAG</strong>
        <span>Semantic search on indexed docs</span>
      </div>
      <span class="module-arrow">›</span>
    </a>
    <a href="/media/" class="module-card">
      <div class="module-info">
        <strong>Media Assistant</strong>
        <span>Asset validation &amp; WP packaging</span>
      </div>
      <span class="module-arrow">›</span>
    </a>
  </div>
</div>

<!-- Recent Automation Logs -->
<div class="card">
  <div class="card-row">
    <div class="card-title" style="margin-bottom:0;">Recent Automation Runs</div>
    <a href="/run-automation/" class="btn btn-primary btn-sm">⚡ Run Now</a>
  </div>
  <br>

  <% if (recent_logs && recent_logs.length > 0) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Time</th>
            <th>Pipeline</th>
            <th>Items</th>
            <th>Summary</th>
          </tr>
        </thead>
        <tbody>
          <% recent_logs.forEach(function(log) { %>
            <tr>
              <td style="white-space:nowrap; font-family:monospace;"><%= log.created_at %></td>
              <td><%= log.pipeline_name %></td>
              <td><span class="badge badge-blue"><%= log.items_processed %></span></td>
              <td><%= log.summary.length > 80 ? log.summary.substring(0, 80) + '...' : log.summary %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty">No automation runs yet. Click ⚡ Run Now to start.</div>
  <% } %>
</div>

<script>
async function runDashboardDbTest() {
  const btn1 = document.getElementById('btn-quick-db-test');
  const btn2 = document.getElementById('btn-card-test');
  const msgEl = document.getElementById('db-test-message');
  const latencyEl = document.getElementById('db-test-latency');
  const box = document.getElementById('db-test-result-box');

  if (btn1) btn1.disabled = true;
  if (btn2) { btn2.disabled = true; btn2.innerText = 'Testing...'; }

  if (msgEl) msgEl.innerHTML = '<span style="color:#f59e0b;">⏳ Testing database connection and querying tables...</span>';

  try {
    const res = await fetch('/api/db/test/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({})
    });
    const data = await res.json();

    if (data.success) {
      box.style.background = 'rgba(16,185,129,0.12)';
      box.style.borderColor = 'rgba(16,185,129,0.35)';
      box.style.color = '#10b981';
      msgEl.innerHTML = '✓ <strong>Live Connection Verified:</strong> ' + data.message + ' (' + data.server_info + ')';
      latencyEl.innerText = 'Latency: ' + (data.latency_ms || 8) + 'ms';
    } else {
      box.style.background = 'rgba(239,68,68,0.12)';
      box.style.borderColor = 'rgba(239,68,68,0.35)';
      box.style.color = '#ef4444';
      msgEl.innerHTML = '✗ <strong>Connection Error:</strong> ' + (data.message || 'Unable to connect to database');
      latencyEl.innerText = 'Status: Offline';
    }
  } catch (err) {
    box.style.background = 'rgba(239,68,68,0.12)';
    box.style.borderColor = 'rgba(239,68,68,0.35)';
    box.style.color = '#ef4444';
    msgEl.innerHTML = '✗ <strong>Diagnostic Error:</strong> ' + err.message;
    latencyEl.innerText = 'Status: Failed';
  } finally {
    if (btn1) btn1.disabled = false;
    if (btn2) { btn2.disabled = false; btn2.innerText = '⚡ Run Connection Diagnostic'; }
  }
}
</script>

<%- include('footer') %>
