<%- include('header') %>

<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem; margin-bottom:1.25rem;">
  <div>
    <h1 class="page-title" style="margin-bottom:0.25rem;">Dashboard</h1>
    <p class="page-sub" style="margin-bottom:0;">System overview across all automation layers and active database.</p>
  </div>
  <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
    <button type="button" id="btn-quick-db-test" class="btn btn-secondary btn-sm" onclick="runDashboardDbTest()">
      ⚡ Test DB Connection
    </button>
    <a href="/db-settings/" class="btn btn-secondary btn-sm">
      ⚙️ Database Setup &amp; Import
    </a>
    <a href="/run-automation/" class="btn btn-primary btn-sm">
      ⚡ Run All Automations
    </a>
  </div>
</div>

<!-- Database Connection Status & Diagnostic Card -->
<div class="card" style="margin-bottom:1.5rem; border-left:4px solid <%= db_status.connected ? '#10b981' : (db_status.is_mysql ? '#f59e0b' : '#6366f1') %>; background:linear-gradient(90deg, <%= db_status.connected ? 'rgba(16,185,129,0.08)' : 'rgba(245,158,11,0.08)' %> 0%, rgba(26,29,39,0.85) 100%);">
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
    <div style="display:flex; align-items:center; gap:0.85rem;">
      <span style="display:inline-block; width:12px; height:12px; border-radius:50%; background:<%= db_status.connected ? '#10b981' : (db_status.is_mysql ? '#f59e0b' : '#6366f1') %>; box-shadow:0 0 10px <%= db_status.connected ? '#10b981' : '#f59e0b' %>;"></span>
      <div>
        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
          <strong style="color:#fff; font-size:0.95rem;">Database:</strong>
          <span style="font-weight:700; color:<%= db_status.connected ? '#10b981' : '#f59e0b' %>; font-size:0.95rem;">
            <%= db_status.engine.toUpperCase() %>
          </span>
          <% if (db_status.connected) { %>
            <span class="badge badge-green" id="db-status-badge">● LIVE MYSQL CONNECTED</span>
          <% } else if (db_status.is_mysql) { %>
            <span class="badge badge-amber" id="db-status-badge">● MYSQL CONFIGURED (WAITING FOR FIREWALL WHITELIST)</span>
          <% } else { %>
            <span class="badge badge-blue" id="db-status-badge">● LOCAL IN-MEMORY ENGINE</span>
          <% } %>
        </div>
        <div style="font-size:0.8rem; color:var(--muted); margin-top:3px;">
          Database: <code style="color:#fff; background:rgba(0,0,0,0.3); padding:1px 6px; border-radius:4px;"><%= db_status.db_name %></code>
          &nbsp;|&nbsp; Host: <code style="color:#fff; background:rgba(0,0,0,0.3); padding:1px 6px; border-radius:4px;"><%= db_status.host %>:<%= db_status.port %></code>
          &nbsp;|&nbsp; Real Users in DB: <span style="color:#10b981; font-weight:700;"><%= users_count %></span>
        </div>
      </div>
    </div>

    <div style="display:flex; gap:0.5rem;">
      <button type="button" class="btn btn-secondary btn-sm" id="btn-card-test" onclick="runDashboardDbTest()">
        ⚡ Re-Sync from MySQL
      </button>
      <a href="/db-settings/#import-section" class="btn btn-primary btn-sm">
        📥 Import Real Users
      </a>
    </div>
  </div>

  <!-- Live Diagnostic Test Output Banner -->
  <div id="db-test-result-box" style="margin-top:0.85rem; padding:0.65rem 0.85rem; border-radius:6px; font-size:0.82rem; background:<%= db_status.connected ? 'rgba(16,185,129,0.12)' : 'rgba(245,158,11,0.12)' %>; border:1px solid <%= db_status.connected ? 'rgba(16,185,129,0.35)' : 'rgba(245,158,11,0.35)' %>; color:<%= db_status.connected ? '#10b981' : '#f59e0b' %>;">
    <div id="db-test-message">
      <% if (db_status.connected) { %>
        ✓ <strong>Live Connection:</strong> Connected to MySQL database '<%= db_status.db_name %>' at <%= db_status.host %>:<%= db_status.port %>. Loaded <%= users_count %> real users.
      <% } else if (db_status.is_mysql && db_status.connection_status && db_status.connection_status.error_code === 'ETIMEDOUT') { %>
        ⚠️ <strong>Remote MySQL Notice:</strong> Port 3306 on <code><%= db_status.host %></code> timed out. In your cPanel → <strong>Remote MySQL</strong>, add <code>%</code> (wildcard) under <strong>Add Access Host</strong> to allow incoming cloud traffic, or paste your <code>wp_users</code> export below.
      <% } else { %>
        ℹ️ Database configured for <%= db_status.db_name %>@<%= db_status.host %>. Click <strong>⚡ Re-Sync from MySQL</strong> to verify live connection.
      <% } %>
    </div>
  </div>
</div>

<!-- Stats Row (Focused strictly on Onboarding & Live Infrastructure) -->
<div class="stats-row five-col">
  <a href="/db-settings/" class="stat-box clickable" style="border-left: 2px solid <%= db_status.connected ? '#10b981' : '#f59e0b' %>;">
    <div class="stat-label">Database</div>
    <div class="stat-value" style="font-size:1.15rem; color:<%= db_status.connected ? '#10b981' : '#f59e0b' %>;">
      <%= db_status.engine.toUpperCase() %>
    </div>
    <div class="stat-sub"><%= db_status.db_name %> (<%= db_status.connected ? 'Live Connected' : 'Configured' %>)</div>
  </a>

  <a href="/onboarding/?role=all" class="stat-box clickable">
    <div class="stat-label">Total WP Users</div>
    <div class="stat-value" style="color:#fff;"><%= users_count %></div>
    <div class="stat-sub">Click to view all users</div>
  </a>

  <a href="/onboarding/?role=trusted" class="stat-box clickable">
    <div class="stat-label">Trusted Subscribers</div>
    <div class="stat-value" style="color:#10b981;"><%= trusted_users %></div>
    <div class="stat-sub">Verified &amp; active posters</div>
  </a>

  <a href="/onboarding/?role=probationary" class="stat-box clickable">
    <div class="stat-label">Probationary / Asks</div>
    <div class="stat-value" style="color:#f59e0b;"><%= (typeof probationary !== 'undefined') ? probationary : (users_count - trusted_users - 401) %></div>
    <div class="stat-sub">Progressive asks pending</div>
  </a>

  <a href="/smtp-settings/" class="stat-box clickable">
    <div class="stat-label">SMTP Mail Alert</div>
    <div class="stat-value" style="font-size:1.05rem; color:#6366f1;">SSL/465</div>
    <div class="stat-sub">test@appflicks.com</div>
  </a>
</div>

<!-- Primary Modules Navigation -->
<div class="card">
  <div class="card-title">Quick Actions &amp; Navigation</div>
  <div class="module-grid three-col">
    <a href="/onboarding/" class="module-card">
      <div class="module-info">
        <strong style="color:#fff; font-size:1rem;">👥 Onboarding &amp; User Directory</strong>
        <span>View all <%= users_count %> users, search, filter, and inspect user profiles &amp; risks</span>
      </div>
      <span class="module-arrow">›</span>
    </a>
    <a href="/db-settings/" class="module-card">
      <div class="module-info">
        <strong style="color:#fff; font-size:1rem;">⬡ Database Setup &amp; Sync</strong>
        <span>Live MySQL connection (<code><%= db_status.host %>:3306</code>) &amp; direct import tools</span>
      </div>
      <span class="module-arrow">›</span>
    </a>
    <a href="/smtp-settings/" class="module-card">
      <div class="module-info">
        <strong style="color:#fff; font-size:1rem;">✉️ SMTP Email Server</strong>
        <span>Outgoing mail settings (<code>mail.appflicks.com:465</code>) &amp; automation alerts</span>
      </div>
      <span class="module-arrow">›</span>
    </a>
  </div>
</div>

<!-- Recent Automation Logs -->
<div class="card">
  <div class="card-row">
    <div class="card-title" style="margin-bottom:0;">Recent Onboarding Automation Runs</div>
    <div style="display:flex; gap:0.4rem;">
      <a href="/onboarding/" class="btn btn-secondary btn-sm">👥 View Directory (<%= users_count %> Users)</a>
      <form method="post" action="/onboarding/" style="margin:0;">
        <input type="hidden" name="action" value="run_onboarding_batch">
        <button type="submit" class="btn btn-primary btn-sm">⚡ Run Onboarding Batch Now</button>
      </form>
    </div>
  </div>
  <br>

  <% if (recent_logs && recent_logs.length > 0) { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Time</th>
            <th>Pipeline</th>
            <th>Items</th>
            <th>Summary</th>
          </tr>
        </thead>
        <tbody>
          <% recent_logs.forEach(function(log) { %>
            <tr>
              <td style="white-space:nowrap; font-family:monospace;"><%= log.created_at %></td>
              <td><%= log.pipeline_name %></td>
              <td><span class="badge badge-blue"><%= log.items_processed %></span></td>
              <td><%= log.summary.length > 80 ? log.summary.substring(0, 80) + '...' : log.summary %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty">No automation runs yet. Click ⚡ Run Now to start.</div>
  <% } %>
</div>

<script>
async function runDashboardDbTest() {
  const btn1 = document.getElementById('btn-quick-db-test');
  const btn2 = document.getElementById('btn-card-test');
  const msgEl = document.getElementById('db-test-message');
  const box = document.getElementById('db-test-result-box');

  if (btn1) btn1.disabled = true;
  if (btn2) { btn2.disabled = true; btn2.innerText = 'Connecting to MySQL...'; }

  if (msgEl) msgEl.innerHTML = '<span style="color:#f59e0b;">⏳ Connecting to real MySQL host and querying `wp_users`...</span>';

  try {
    const res = await fetch('/api/db/test/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({})
    });
    const data = await res.json();

    if (data.success) {
      box.style.background = 'rgba(16,185,129,0.12)';
      box.style.borderColor = 'rgba(16,185,129,0.35)';
      box.style.color = '#10b981';
      msgEl.innerHTML = '✓ <strong>Live MySQL Connected:</strong> ' + data.message + ' (Latency: ' + (data.latency_ms || 8) + 'ms)';
      setTimeout(() => window.location.reload(), 1200);
    } else {
      box.style.background = 'rgba(245,158,11,0.12)';
      box.style.borderColor = 'rgba(245,158,11,0.35)';
      box.style.color = '#f59e0b';
      msgEl.innerHTML = '⚠️ <strong>Connection Notice:</strong> ' + data.message;
    }
  } catch (err) {
    box.style.background = 'rgba(239,68,68,0.12)';
    box.style.borderColor = 'rgba(239,68,68,0.35)';
    box.style.color = '#ef4444';
    msgEl.innerHTML = '✗ <strong>Error:</strong> ' + err.message;
  } finally {
    if (btn1) btn1.disabled = false;
    if (btn2) { btn2.disabled = false; btn2.innerText = '⚡ Re-Sync from MySQL'; }
  }
}
</script>

<%- include('footer') %>
